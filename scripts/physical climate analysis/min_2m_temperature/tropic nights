# --- 7 EXAKTE MODELL-KOMBINATIONEN ---
VALID_MODELS = [
    "cnrm_cerfacs_cm5_cnrm_aladin63",
    "ichec_ec_earth_knmi_racmo22e",
    "ichec_ec_earth_smhi_rca4",
    "ipsl_cm5a_mr_smhi_rca4",
    "mohc_hadgem2_es_smhi_rca4",
    "mpi_m_mpi_esm_lr_smhi_rca4",
    "ncc_noresm1_m_smhi_rca4",
]


def load_and_fix_da(path):
    """Lädt Tmin Daten und reduziert sie auf eine saubere Celsius-
    Zeitreihe."""
    ds = xr.open_dataset(path)

    possible_vars = ["tasmin", "tn", "tmin", "mint"]
    var_name = [
        v
        for v in ds.data_vars
        if v.lower() in possible_vars or "tasmin" in v.lower()
    ][0]
    da = ds[var_name]

    if len(da.dims) > 1:
        spatial_dims = [d for d in da.dims if d != "time"]
        da = da.mean(dim=spatial_dims)

    da = da.sortby("time")

    if hasattr(da.time, "calendar"):
        da = da.convert_calendar("standard", align_on="date")

    da = da.sel(time=~da.get_index("time").duplicated())

    if da.max() > 100 or (
        hasattr(da, "units") and da.attrs["units"] in ["K", "Kelvin"]
    ):
        da = da - 273.15
        da.attrs["units"] = "degC"

    return da.load()


def count_tropical_nights(da, threshold=20, min_days=1):
    """Berechnet Tropennächte (Tmin >= 20°C) und Ketten davon pro Jahr."""

    def find_runs(arr, length):
        count = 0
        current_run = 0
        for val in arr:
            if val == 1:
                current_run += 1
            else:
                if current_run >= length:
                    count += 1
                current_run = 0
        if current_run >= length:
            count += 1
        return count

    years = np.unique(da.time.dt.year)
    yearly_counts = []

    for year in years:
        year_data = (da >= threshold).astype(int).sel(time=str(year)).values
        yearly_counts.append(find_runs(year_data, min_days))

    return np.mean(yearly_counts) if yearly_counts else 0


def process_ensemble_stats(hist_path, proj_path, target_years, wave_len):
    """Berechnet P15, Median und P85 der Deltas über das 7-Modell-Ensemble."""
    deltas = []
    if not os.path.exists(proj_path) or not os.path.exists(hist_path):
        return None

    files = [f for f in os.listdir(proj_path) if f.endswith(".nc")]
    h_list = [h for h in os.listdir(hist_path) if h.endswith(".nc")]

    for f in files:
        matched_model = next(
            (m for m in VALID_MODELS if m in f.lower()), None
        )
        if not matched_model:
            continue

        try:
            da_p = load_and_fix_da(os.path.join(proj_path, f))
            match = [h for h in h_list if matched_model in h.lower()]
            if not match:
                continue

            da_h = load_and_fix_da(os.path.join(hist_path, match[0]))

            val_hist = count_tropical_nights(
                da_h.sel(time=slice("1971", "2000")), min_days=wave_len
            )
            val_proj = count_tropical_nights(
                da_p.sel(
                    time=slice(str(target_years[0]), str(target_years[1]))
                ),
                min_days=wave_len,
            )

            deltas.append(val_proj - val_hist)
        except Exception as e:
            print(f"Fehler bei Modell {matched_model}: {e}")
            continue

    if not deltas:
        return None

    return {
        "p15": float(np.percentile(deltas, 15)),
        "median": float(np.median(deltas)),
        "p85": float(np.percentile(deltas, 85)),
    }


def build_scenario_dataframe(hist_path, proj_path, da_dwd):
    """Erstellt eine Ergebnistabelle für ein Szenario inkl. Perzentilen."""
    durations = [1, 3, 5]
    horizons = [("2035 (2021-2050)", (2021, 2050)), ("2055 (2041-2070)", (2041, 2070))]
    rows = []

    for d in durations:
        label = "Einzeln" if d == 1 else f"≥ {d} Tage am Stück"
        base_dwd = count_tropical_nights(
            da_dwd.sel(time=slice("1971", "2000")), min_days=d
        )

        for time_label, years in horizons:
            stats = process_ensemble_stats(hist_path, proj_path, years, d)
            if not stats:
                continue

            rows.append({
                "Ereignis": label,
                "Zeithorizont": time_label,
                "Historisch (DWD 71-00)": round(base_dwd, 2),
                "Änderung P15": round(stats["p15"], 2),
                "Änderung Median": round(stats["median"], 2),
                "Änderung P85": round(stats["p85"], 2),
                "Prognose P15": round(max(0, base_dwd + stats["p15"]), 2),
                "Prognose Median": round(max(0, base_dwd + stats["median"]), 2),
                "Prognose P85": round(max(0, base_dwd + stats["p85"]), 2),
            })

    return pd.DataFrame(rows)


def save_excel(df_rcp45, df_rcp85, file_path):
    """Speichert zwei getrennte Excel-Sheets."""
    with pd.ExcelWriter(file_path, engine="openpyxl") as writer:
        if not df_rcp45.empty:
            df_rcp45.to_excel(writer, sheet_name="RCP 4.5", index=False)
        if not df_rcp85.empty:
            df_rcp85.to_excel(writer, sheet_name="RCP 8.5", index=False)

    print(f"\n📊 Excel-Datei gespeichert unter: {file_path}")


