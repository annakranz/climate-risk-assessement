For dwd-data Precipitation in mm
###########################################################################################################################
import os
import re
import requests
from bs4 import BeautifulSoup
from tqdm import tqdm


START_YEAR = 1971
END_YEAR = 2005

DOWNLOAD_DIR = os.path.join(".", "data", "precipitation")
BASE_URL = "https://opendata.dwd.de/climate_environment/CDC/grids_germany/daily/hyras_de/precipitation/"

if not os.path.exists(DOWNLOAD_DIR):
    os.makedirs(DOWNLOAD_DIR)
    print(f"Directory created: {os.path.abspath(DOWNLOAD_DIR)}")

def download_hyras_precipitation(start_year=START_YEAR, end_year=END_YEAR):
    print(f"Scanning server for precipitation files ({start_year}-{end_year})...")
    
    try:
        response = requests.get(BASE_URL, timeout=30)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, 'html.parser')
        
        all_nc_files = [
            node.get('href') for node in soup.find_all('a') 
            if node.get('href') and node.get('href').endswith('.nc')
        ]
        
        nc_files = []
        for file_name in all_nc_files:
            match = re.search(r"(\d{4})", file_name)
            if match:
                year = int(match.group(1))
                if start_year <= year <= end_year:
                    nc_files.append(file_name)
        
        if not nc_files:
            print(f"No .nc files found for the period {start_year}-{end_year}.")
            return

        print(f"Found {len(nc_files)} file(s) for synchronization ({start_year}-{end_year}).\n")

        for file_name in nc_files:
            file_url = BASE_URL + file_name
            target_path = os.path.join(DOWNLOAD_DIR, file_name)

            # Skip existing files
            if os.path.exists(target_path):
                print(f"Already downloaded: {file_name}")
                continue

            try:
                with requests.get(file_url, stream=True, timeout=60) as r_file:
                    r_file.raise_for_status()
                    total_size = int(r_file.headers.get('content-length', 0))
                    
                    with open(target_path, 'wb') as f_out, tqdm(
                        desc=f"Downloading {file_name}",
                        total=total_size,
                        unit='iB',
                        unit_scale=True,
                        unit_divisor=1024,
                    ) as bar:
                        for chunk in r_file.iter_content(chunk_size=65536):  # 64KB chunks
                            if chunk:
                                f_out.write(chunk)
                                bar.update(len(chunk))
            except Exception as e:
                print(f"\nDownload failed for {file_name}: {e}")
                if os.path.exists(target_path):
                    os.remove(target_path)  # Clean up incomplete file

        print("\n" + "=" * 40)
        print(f"FINISHED! Precipitation files ({start_year}-{end_year}) saved to:")
        print(f"{os.path.abspath(DOWNLOAD_DIR)}")

    except Exception as e:
        print(f"Server connection failed: {e}")

if __name__ == "__main__":
    download_hyras_precipitation()
