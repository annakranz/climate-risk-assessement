import os
import requests
from bs4 import BeautifulSoup
from tqdm import tqdm
import re



DOWNLOAD_DIR = r"YOUR_PATH"                                                   #change name

BASE_URL = "https://opendata.dwd.de/climate_environment/CDC/grids_germany/daily/hyras_de/air_temperature_mean/"

if not os.path.exists(DOWNLOAD_DIR):
    os.makedirs(DOWNLOAD_DIR)
    print(f"dictionary: {DOWNLOAD_DIR}")

def download_hyras_tmean_1971_2005():                                         #change name
    print(f" HYRAS Tmean (1971-2005)...")                                     #change name
    
    try:
        
        response = requests.get(BASE_URL, timeout=30)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, 'html.parser')
        
        
        all_nc_files = [node.get('href') for node in soup.find_all('a') if node.get('href').endswith('.nc')]
        
        
        nc_files = []
        for f in all_nc_files:
            
            match = re.search(r"(\d{4})", f)
            if match:
                year = int(match.group(1))
                if 1971 <= year <= 2005:
                    nc_files.append(f)
        
        if not nc_files:
            print("No .nc files 1971-2005.")
            return

        print(f"{len(nc_files)} .nc files 1971-2005 found.\n")

        for file_name in nc_files:
            file_url = BASE_URL + file_name
            target_path = os.path.join(DOWNLOAD_DIR, file_name)

            
            if os.path.exists(target_path):
                print(f"already exists: {file_name}")
                continue

           
            try:
                with requests.get(file_url, stream=True, timeout=60) as r_file:
                    r_file.raise_for_status()
                    total_size = int(r_file.headers.get('content-length', 0))
                    
                    with open(target_path, 'wb') as f_out, tqdm(
                        desc=f"Lade {file_name}",
                        total=total_size,
                        unit='iB',
                        unit_scale=True,
                        unit_divisor=1024,
                    ) as bar:
                        for chunk in r_file.iter_content(chunk_size=65536): 
                            if chunk:
                                f_out.write(chunk)
                                bar.update(len(chunk))
            except Exception as e:
                print(f"\ndownload dailed {file_name}: {e}")
                if os.path.exists(target_path):
                    os.remove(target_path) 

        print("\n" + "="*40)
        print(f"FINISHED! files (1971-2005):")
        print(f"{DOWNLOAD_DIR}")

    except Exception as e:
        print(f"server connection failed: {e}")

if __name__ == "__main__":
    download_hyras_tmean_1971_2005()                                                   #change name



