For dwd-data kelvin into °C (air_temperature_mean, air_temperature_max, air_temperature_min)
###########################################################################################################################
import os
import requests
from bs4 import BeautifulSoup
from tqdm import tqdm


DOWNLOAD_DIR = os.path.join(".", "data", "air_temperature_min")
BASE_URL = "https://opendata.dwd.de/climate_environment/CDC/grids_germany/daily/hyras_de/air_temperature_min/"

if not os.path.exists(DOWNLOAD_DIR):
    os.makedirs(DOWNLOAD_DIR)
    print(f"Directory created: {os.path.abspath(DOWNLOAD_DIR)}")

def download_hyras_data():
    print("Scanning DWD server for HYRAS NetCDF files...")
    
    try:
        
        response = requests.get(BASE_URL, timeout=30)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, 'html.parser')
        
    
        nc_files = [node.get('href') for node in soup.find_all('a') if node.get('href') and node.get('href').endswith('.nc')]
        
        if not nc_files:
            print("No .nc files found in the specified directory.")
            return

        print(f"Found {len(nc_files)} file(s) for synchronization.\n")

        for file_name in nc_files:
            file_url = BASE_URL + file_name
            target_path = os.path.join(DOWNLOAD_DIR, file_name)

            
            if os.path.exists(target_path):
                print(f"Already downloaded: {file_name}")
                continue

            
            try:
                with requests.get(file_url, stream=True, timeout=60) as r_file:
                    r_file.raise_for_status()
                    total_size = int(r_file.headers.get('content-length', 0))
                    
                    with open(target_path, 'wb') as f, tqdm(
                        desc=f"Downloading {file_name}",
                        total=total_size,
                        unit='iB',
                        unit_scale=True,
                        unit_divisor=1024,
                    ) as bar:
                        for chunk in r_file.iter_content(chunk_size=65536):  # 64KB chunks
                            if chunk:
                                f.write(chunk)
                                bar.update(len(chunk))
            except Exception as e:
                print(f"\nError downloading {file_name}: {e}")
                if os.path.exists(target_path):
                    os.remove(target_path)  # Clean up incomplete file

        print("\n" + "=" * 40)
        print("COMPLETED! All files are saved in:")
        print(f"{os.path.abspath(DOWNLOAD_DIR)}")

    except Exception as e:
        print(f"Critical error connecting to the server: {e}")

if __name__ == "__main__":
    download_hyras_data()



