import os
import re
import glob
import numpy as np
import xarray as xr


# Target coordinates (e.g., location of interest)
TARGET_LAT = 49.79
TARGET_LON = 9.93


INPUT_DIR = os.path.join(".", "data", "tmax")
OUTPUT_FILE = os.path.join(".", "output", "tmax_point_location.nc")

def extract_single_point_timeseries(target_lat=TARGET_LAT, target_lon=TARGET_LON):
    search_pattern = os.path.join(INPUT_DIR, "*.nc")
    all_files = glob.glob(search_pattern)
    
    best_files = {}
    for fpath in all_files:
        fname = os.path.basename(fpath)
        year_match = re.search(r"(\d{4})", fname)
        if year_match:
            year = year_match.group(1)
            if year not in best_files:
                best_files[year] = fpath
            else:
                curr_name = os.path.basename(best_files[year])
                if "v6-1" in fname and "v6-0" in curr_name:
                    best_files[year] = fpath
                elif "v6-1" in fname and "v6-1" in curr_name:
                    if os.path.getsize(fpath) > os.path.getsize(best_files[year]):
                        best_files[year] = fpath

    sorted_files = [best_files[year] for year in sorted(best_files.keys())]
    
    if not sorted_files:
        print(f"Error: No NetCDF (.nc) files found in '{INPUT_DIR}'.")
        return

    datasets = []
    print(f"Starting point extraction ({target_lat}, {target_lon}) from {len(sorted_files)} files...")

    for fpath in sorted_files:
        year = re.search(r"(\d{4})", os.path.basename(fpath)).group(1)
        try:
            with xr.open_dataset(fpath, decode_coords="all") as ds:
                # Handle projected grid coordinates by calculating distance in geographic coordinates (lat/lon)
                dist = ((ds.lat - target_lat)**2 + (ds.lon - target_lon)**2)
                
                # Find indices of the minimum distance pixel
                idx_y, idx_x = np.unravel_index(np.argmin(dist.values), dist.shape)
                
                # Determine spatial dimension names dynamically (e.g., y/x or lat/lon)
                dim_y = dist.dims[0]
                dim_x = dist.dims[1]
                
                # Extract exact single grid cell using positional indexing
                selectors = {dim_y: idx_y, dim_x: idx_x}
                subset = ds.isel(**selectors).load()
                
                if "time" in subset.dims:
                    datasets.append(subset)
                    print(f"Year {year} successfully extracted...", end="\r")
        except Exception as e:
            print(f"\nError processing year {year}: {e}")

    if not datasets:
        print("\nError: No single-point data could be extracted.")
    else:
        print("\nConcatenating annual datasets into a unified time series...")
        full_ds = xr.concat(datasets, dim="time")

        # Dynamically identify the climate data variable
        possible_vars = ['tas', 'tasmean', 'tmean', 'tasmax', 'tasmin', 'pr']
        var_name = [v for v in full_ds.data_vars if v in possible_vars or 'tas' in v.lower()][0]
        
        print(f"Identified variable for processing: '{var_name}'")

        # Process units based on variable type
        if var_name == 'pr':
            full_ds['precipitation_mm'] = full_ds[var_name]
            full_ds['precipitation_mm'].attrs['units'] = 'mm'
            full_ds['precipitation_mm'].attrs['long_name'] = 'Daily precipitation sum at target location'
            print("Precipitation data retained without temperature conversion (Unit: mm).")
        else:
            # Convert Kelvin to Celsius
            full_ds['temperature_c'] = full_ds[var_name] - 273.15
            full_ds['temperature_c'].attrs['units'] = 'degC'
            full_ds['temperature_c'].attrs['long_name'] = 'Near-surface air temperature in Celsius at target location'
            print("Temperature data converted from Kelvin to Celsius.")

        # Ensure output directory exists before writing
        output_dir = os.path.dirname(OUTPUT_FILE)
        if output_dir and not os.path.exists(output_dir):
            os.makedirs(output_dir)

        print("Saving final single-point NetCDF file...")
        full_ds.to_netcdf(OUTPUT_FILE)
        
        print("\n" + "=" * 40)
        print(f"SUCCESS: Single-point NetCDF file created at:\n{os.path.abspath(OUTPUT_FILE)}")
        print(f"Time span: {int(full_ds.time.dt.year.min().values)} to {int(full_ds.time.dt.year.max().values)}")
        print("=" * 40)

if __name__ == "__main__":
    extract_single_point_timeseries()



