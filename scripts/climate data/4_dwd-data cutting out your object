#air_temperature_mean 



import os
import glob
import re
import xarray as xr


INPUT_DIR = r"YOUR DWD FOLDER NAME"
OUTPUT_FILE = r"YOUR FILE NAME"

TARGET_LAT = xx.xx
TARGET_LON = x.xx

COORDINATE_BUFFER = 0.05

def process_daily_mean_temperature():
    
    search_pattern = os.path.join(INPUT_DIR, "*.nc")
    all_files = glob.glob(search_pattern)
    
    best_files = {}
    for fpath in all_files:
        fname = os.path.basename(fpath)
        year_match = re.search(r"(\d{4})", fname)
        if year_match:
            year = year_match.group(1)
            if year not in best_files:
                best_files[year] = fpath
            else:
                curr_name = os.path.basename(best_files[year])
                
                if "v6-0" in fname and "v6-1" in curr_name:
                    best_files[year] = fpath
    
    sorted_files = [best_files[year] for year in sorted(best_files.keys())]
    
    if not sorted_files:
        print(f"Error: No NetCDF (.nc) files found in {INPUT_DIR}!")
        return

    datasets = []
    print(f"Extracting target region from {len(sorted_files)} daily mean temperature files...")

   
    for fpath in sorted_files:
        year = re.search(r"(\d{4})", os.path.basename(fpath)).group(1)
        try:
            
            with xr.open_dataset(fpath, decode_coords="all") as ds:
                
                dist = ((ds.lat - TARGET_LAT)**2 + (ds.lon - TARGET_LON)**2)
                
                
                subset = ds.where(dist < COORDINATE_BUFFER, drop=True).load()
                
                if len(subset.time) > 0:
                    datasets.append(subset)
                    print(f"Year {year} successfully loaded...", end="\r")
        except Exception as e:
            print(f"\nError processing year {year}: {e}")

    if not datasets:
        print("\nError: No data could be extracted.")
    else:
        print("\nConcatenating annual datasets into a continuous time series...")
        full_ds = xr.concat(datasets, dim="time")

        possible_vars = ['tas', 'tmean', 'absolute_temperature']
        var_name = [v for v in full_ds.data_vars if v in possible_vars or 'tas' in v.lower()][0]
        
       
        full_ds['tmean_c'] = full_ds[var_name] - 273.15
        full_ds['tmean_c'].attrs['units'] = 'degC'
        full_ds['tmean_c'].attrs['long_name'] = 'Regional Mean Air Temperature'

       
        print("Saving final consolidated NetCDF file...")
        
       
        output_dir = os.path.dirname(OUTPUT_FILE)
        if output_dir and not os.path.exists(output_dir):
            os.makedirs(output_dir)
            
        full_ds[['tmean_c']].to_netcdf(OUTPUT_FILE)
        
        print("\n" + "="*40)
        print(f"SUCCESS: Regional time series created at:\n{OUTPUT_FILE}")
        print(f"Covered Period: {full_ds.time.dt.year.min().values} to {full_ds.time.dt.year.max().values}")

if __name__ == "__main__":
    process_daily_mean_temperature()



